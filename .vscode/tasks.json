{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Vite client",
      "type": "npm",
      "script": "dev:client",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^()$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*vite.*",
          "endsPattern": ".*Local:.*localhost.*"
        }
      }
    }
  ]
}
